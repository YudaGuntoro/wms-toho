# Copy this file to .env when you need local environment overrides.
# The default development setup uses the on-premise MySQL database.

FRONTEND_ORIGIN=http://localhost:3000
# API URLs in the browser are always same-origin /api.
# Set API_PROXY_TARGET in Frontend/.env.local for local development.
API_PROXY_TARGET=http://127.0.0.1:5243

MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;User ID=root;Password=root_native;Database=wms-system-toho;SslMode=None;AllowPublicKeyRetrieval=True;

JWT_ISSUER=WMS-Demo
JWT_AUDIENCE=WMS-Demo.Frontend
JWT_SIGNING_KEY=replace-with-a-long-random-production-secret
JWT_EXPIRES_HOURS=8

SWAGGER_ENABLED=true
